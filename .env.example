# ---------------------------------------------------------------------------
# EMS — environment template
# Copy to .env for local development. Every variable here is validated by
# apps/api/src/config/env.schema.ts at boot; the process exits on a bad value
# rather than starting in a half-configured state.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_NAME=EMS
APP_URL=http://localhost:3000
API_PORT=4000
API_PREFIX=api
LOG_LEVEL=debug

# --- Platform domain ------------------------------------------------------
# Tenant subdomains are issued as <slug>.PLATFORM_ROOT_DOMAIN
PLATFORM_ROOT_DOMAIN=ems.localhost
CONSOLE_URL=http://localhost:3000
STOREFRONT_URL=http://localhost:3001

# --- MySQL (system of record) ---------------------------------------------
# MYSQL_PORT is both the container's published host port and the port the API
# connects to. Change it (e.g. 3307) if you already run MySQL natively on 3306 —
# do not stop your local server just to free the default.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ems
MYSQL_USER=ems
MYSQL_PASSWORD=emspassword
MYSQL_ROOT_PASSWORD=rootpassword
# Optional read replica for @ReadOnly() routes; falls back to primary if unset.
MYSQL_REPLICA_HOST=
MYSQL_POOL_SIZE=20
MYSQL_LOGGING=false

# --- MongoDB (logs & analytics) -------------------------------------------
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=mongopassword
MONGO_PORT=27017
MONGO_DATABASE=ems_logs
MONGO_URI=mongodb://root:mongopassword@127.0.0.1:27017/ems_logs?authSource=admin

# --- Redis (cache, sessions, queues) --------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Namespaces every key so a misconfigured REDIS_URL cannot cross-contaminate envs.
REDIS_KEY_PREFIX=dev

# --- Redis for BullMQ (separate instance) ---------------------------------
# maxmemory-policy is server-wide: the cache needs volatile-lru, BullMQ needs
# noeviction. One instance cannot be both, so queues get their own.
REDIS_QUEUE_HOST=127.0.0.1
REDIS_QUEUE_PORT=6380
REDIS_QUEUE_PASSWORD=
REDIS_QUEUE_DB=0

# --- JWT (RS256) ----------------------------------------------------------
# Generate with: pnpm run keys:generate
# Base64-encoded PEM so the whole key fits on one env line.
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_KEY_ID=dev-key-1
JWT_ISSUER=ems.local
JWT_AUDIENCE=ems.api
JWT_ACCESS_TTL=10m
JWT_REFRESH_TTL=30d
JWT_STOREFRONT_TTL=24h

# --- Crypto ---------------------------------------------------------------
# 32-byte key, base64. Used for AES-256-GCM field encryption (MFA secrets, etc.)
ENCRYPTION_KEY_BASE64=
BCRYPT_ROUNDS=12

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=5
RATE_LIMIT_DEFAULT_PER_MIN=120

# --- Logging pipeline -----------------------------------------------------
MONGO_LOGGING_ENABLED=true
MONGO_LOG_BUFFER_SIZE=10000
MONGO_LOG_FLUSH_INTERVAL_MS=1000
MONGO_LOG_FLUSH_BATCH=500
# 1.0 = log every 2xx GET. Lower it in production; errors/mutations are always 1.0.
MONGO_LOG_SAMPLE_RATE_SUCCESS_GET=0.1

# --- Object storage (MinIO locally, S3 in prod) ---------------------------
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=ems-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Mail (MailHog locally) ----------------------------------------------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="EMS <no-reply@ems.localhost>"

# --- Queues ---------------------------------------------------------------
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_POLL_MS=500
OUTBOX_RELAY_BATCH=100

# --- Observability --------------------------------------------------------
METRICS_ENABLED=true
SWAGGER_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Frontend (Next.js public vars) --------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=EMS

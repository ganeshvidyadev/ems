# Dependencies
node_modules/
.pnpm-store/
# This is a pnpm workspace (pnpm-lock.yaml is the real lockfile) — npm has
# been used as a local workaround in some dev environments and must never
# leave its own lockfile behind for git to pick up.
package-lock.json

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Turborepo
.turbo/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
!**/fixtures/**/*.pem
apps/api/keys/

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Test output
coverage/
.nyc_output/
playwright-report/
test-results/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Office temp/lock files
~$*

# Local data volumes
docker/data/

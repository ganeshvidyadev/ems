# Template only — never commit a filled-in copy of this file.
#
# In practice this Secret is not applied from a checked-in YAML at all: it is
# populated by the CD pipeline from its own secret store (GitHub Actions →
# AWS Secrets Manager, per `infra/terraform`) via `kubectl create secret
# generic ems-api-secrets --from-literal=... --dry-run=client -o yaml | kubectl apply -f -`,
# so a real value never round-trips through a file on disk or in git history.
# This file exists so a reviewer can see the exact key *names* the
# Deployments expect without needing to read `env.schema.ts`.
apiVersion: v1
kind: Secret
metadata:
  name: ems-api-secrets
  namespace: ems
type: Opaque
stringData:
  MYSQL_USER: 'CHANGEME'
  MYSQL_PASSWORD: 'CHANGEME'
  MONGO_URI: 'mongodb://CHANGEME:CHANGEME@ems-mongo.ems-data.svc.cluster.local:27017/ems_logs?authSource=admin'
  REDIS_PASSWORD: 'CHANGEME'
  REDIS_QUEUE_PASSWORD: 'CHANGEME'

  JWT_PRIVATE_KEY_BASE64: 'CHANGEME' # pnpm run keys:generate
  JWT_PUBLIC_KEY_BASE64: 'CHANGEME'
  JWT_KEY_ID: 'CHANGEME' # must NOT start with "dev-" — env.schema.ts refuses to boot otherwise
  ENCRYPTION_KEY_BASE64: 'CHANGEME' # 32 random bytes, base64-encoded

  S3_ACCESS_KEY: 'CHANGEME'
  S3_SECRET_KEY: 'CHANGEME'

  SMTP_USER: 'CHANGEME'
  SMTP_PASSWORD: 'CHANGEME'

  RAZORPAY_KEY_ID: 'CHANGEME'
  RAZORPAY_KEY_SECRET: 'CHANGEME'
  RAZORPAY_WEBHOOK_SECRET: 'CHANGEME'

  SHIPROCKET_EMAIL: 'CHANGEME'
  SHIPROCKET_PASSWORD: 'CHANGEME'
  SHIPROCKET_WEBHOOK_SECRET: 'CHANGEME'

  CLOUDFLARE_API_TOKEN: 'CHANGEME'
  ACME_ACCOUNT_EMAIL: 'ops@ems.example.com'

  EBAY_CLIENT_ID: 'CHANGEME'
  EBAY_CLIENT_SECRET: 'CHANGEME'
  EBAY_REDIRECT_URI_NAME: 'CHANGEME'
